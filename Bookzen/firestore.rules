rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection (Profile details)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);

      // User Wishlist subcollection
      match /wishlist/{wishlistId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Direct Wishlist subcollection pattern match
    match /users/{userId}/wishlist/{wishlistId} {
      allow read, write: if isOwner(userId);
    }

    // Books Collection
    match /books/{bookId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (request.auth.token.email != null && resource.data.sellerEmail == request.auth.token.email)
      );
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.buyerEmail == request.auth.token.email ||
          resource.data.sellerEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email
        ))
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.buyerEmail == request.auth.token.email ||
          resource.data.sellerEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email
        ))
      );
      allow delete: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid
      );
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.receiverUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.receiverEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email
        ))
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.receiverUid == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && (
          resource.data.receiverEmail == request.auth.token.email ||
          resource.data.userEmail == request.auth.token.email
        ))
      );
    }

    // Conversations Collection (Unified Buyer ↔ Seller Marketplace Messaging)
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid ||
        (resource.data.participantUids is list && request.auth.uid in resource.data.participantUids) ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        (request.auth.token.email != null && (
          resource.data.buyerEmail == request.auth.token.email ||
          resource.data.sellerEmail == request.auth.token.email ||
          (resource.data.participantEmails is list && request.auth.token.email in resource.data.participantEmails)
        ))
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.buyerUid == request.auth.uid ||
        request.resource.data.sellerUid == request.auth.uid ||
        (request.resource.data.participantUids is list && request.auth.uid in request.resource.data.participantUids) ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants) ||
        (request.auth.token.email != null && (
          request.resource.data.buyerEmail == request.auth.token.email ||
          request.resource.data.sellerEmail == request.auth.token.email
        ))
      );
      allow delete: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      // Conversation Messages Subcollection
match /messages/{messageId} {
  allow read: if isAuthenticated();

  allow create: if isAuthenticated()
    && request.resource.data.senderId == request.auth.uid;

  allow update, delete: if isAuthenticated()
    && (
      resource.data.senderId == request.auth.uid ||
      resource.data.receiverId == request.auth.uid
    );
}
    }

    // Legacy Chats Collection (Backward Compatibility)
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
